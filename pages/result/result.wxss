.result-hero {
  margin-top: 8rpx;
}

.result-kicker {
  font-size: 26rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 12rpx;
}

.archetype-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.35;
  color: #1a1030;
}

.archetype-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: #4b5563;
}

.score-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.score-chip {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5b21b6;
  background: rgba(124, 58, 237, 0.1);
  border-radius: 999rpx;
}

.bars-card {
  margin-top: 28rpx;
}

.bars-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #312e81;
  margin-bottom: 24rpx;
}

.bar-row + .bar-row {
  margin-top: 28rpx;
}

.bar-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.bar-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.bar-score {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
}

.bar-track {
  height: 22rpx;
  border-radius: 999rpx;
  background: #ede9fe;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899);
  transition: width 0.6s ease;
}

.result-cta {
  margin-top: 36rpx;
}

.fine-print {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(248, 245, 255, 0.5);
}
