# Copy to .env at repo root and/or web/.env.local for Next.js public vars.

# --- Backend (FastAPI) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console (OAuth client).
OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/youtube/callback
# Where users land after OAuth (no trailing slash).
FRONTEND_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000

# Comma-separated YouTube OAuth scope URLs (must match Google Cloud OAuth consent screen).
# Defaults include readonly + upload + force-ssl for metadata edits.
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.force-ssl

# Reddit (optional) — official OAuth2 client-credentials for public listings.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# e.g. "trendsetter:local:v0.1 (by /u/yourredditusername)"
REDDIT_USER_AGENT="trendsetter:local:v0.1 (by /u/example)"
REDDIT_DEFAULT_SUBREDDIT=videos
TRENDS_CACHE_TTL_SECONDS=90

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
