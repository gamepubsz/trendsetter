# =============================================================================
# YouTube Channel Manager - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Application ---
APP_ENV=development         # development | production
APP_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite:///./data/yt_manager.db

# --- YouTube Data API v3 ---
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# --- OpenAI API ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini     # cheap model for most tasks
OPENAI_ADVANCED_MODEL=gpt-4o         # for complex content generation

# Token budget per day (to control costs). 0 = unlimited
OPENAI_DAILY_TOKEN_BUDGET=100000

# --- Reddit API (for trend analysis) ---
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=YTChannelManager/1.0

# --- Cache ---
CACHE_DIR=./data/cache
# How long to cache AI responses (seconds). Default: 1 hour
AI_CACHE_TTL=3600
# How long to cache trend data (seconds). Default: 30 minutes
TREND_CACHE_TTL=1800

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
